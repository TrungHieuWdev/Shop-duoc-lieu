# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES EXAMPLE (VITE)
# Sao chép file này thành .env trong thư mục frontend khi chạy thực tế
# ==============================================================================

# URL gốc của Backend REST API
VITE_API_BASE_URL=http://localhost:5000

# Thông tin hiển thị cửa hàng
VITE_SHOP_NAME=Tiệm Thảo Mộc Ngân Hà
VITE_SHOP_PHONE=0987654321
VITE_SHOP_EMAIL=lienhe@nganhashop.vn
VITE_SHOP_ADDRESS=123 Đường Cỏ May, Phường 10, TP. Hồ Chí Minh

# Chính sách vận chuyển hiển thị
VITE_DEFAULT_SHIPPING_FEE=30000
VITE_FREE_SHIPPING_THRESHOLD=350000

# Chu kỳ lặp Polling kiểm tra trạng thái thanh toán (mili-giây)
VITE_PAYMENT_POLLING_INTERVAL_MS=3000

