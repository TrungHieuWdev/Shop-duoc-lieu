# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES EXAMPLE (EXPRESS + MYSQL + SEPAY)
# Sao chép file này thành .env trong thư mục backend khi chạy thực tế
# Tuyệt đối không commit file .env chứa mật khẩu thực tế lên Git
# ==============================================================================

# Cấu hình máy chủ
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cấu hình Cơ sở dữ liệu MySQL (mysql2/promise pool)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=herbal_shop
DB_CONNECTION_LIMIT=10

# Cấu hình Cổng thanh toán SePay (Tài khoản nhận tiền của Chủ shop)
SEPAY_WEBHOOK_API_KEY=sepay_webhook_secret_key_from_dashboard
SEPAY_BANK_NAME=Vietcombank
SEPAY_BANK_CODE=VCB
SEPAY_ACCOUNT_NUMBER=1017588888
SEPAY_ACCOUNT_NAME=TIEM THAO MOC NGAN HA
SEPAY_QR_TEMPLATE=compact
SEPAY_TRANSFER_PREFIX=DH

# Cấu hình Email gửi thông báo cho Chủ shop (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_store_system_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
STORE_OWNER_EMAIL=chushop_nganha@gmail.com

# Cấu hình chính sách tính tiền mặc định
SHIPPING_FEE_DEFAULT=30000
FREE_SHIPPING_THRESHOLD=350000

